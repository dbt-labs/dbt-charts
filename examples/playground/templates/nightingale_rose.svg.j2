{#---
description: Polar area ("coxcomb") diagram after Florence Nightingale, one row per period in query order. Each period is a wedge of equal angle whose area, not radius, is proportional to each series' value; series overlay largest first, so every one stays visible. Colors come from color_for(name, "series"), so a board can pin them under style.charts.category_colors.series. An optional panel column draws one rose per panel, side by side, on a shared scale.
channels:
  x:
    description: Column labeling each wedge, such as the month.
  y:
    description: Columns drawn as overlaid wedges; their names key the colors.
    multiple: true
options:
  panel:
    type: column
    default: null
    description: Optional column; each distinct value draws its own rose, left to right in query order.
  value_format:
    type: string
    default: ',.0f'
  start_angle:
    type: number
    default: 270
    description: Degrees clockwise from twelve o'clock where the first wedge starts.
---#}
{% set p = options %}
{% set label_col = channels.x %}
{% set series_col = channels.y %}
{% if not rows %}{{ raise_error("A rose needs at least one period.") }}{% endif %}
{% set ns = namespace(panels=[], roots=[]) %}
{% for r in rows %}
  {% set key = (r[p.panel] | string) if p.panel else "" %}
  {% if key not in ns.panels %}{% set ns.panels = ns.panels + [key] %}{% endif %}
{% endfor %}
{% set label_floor = 0.55 %}
{% set start = p.start_angle / 180 * math.pi %}
{# Extents are in units of sqrt(value), so the scale k is solved after: up and down are how far wedges and labels reach above and below the center. #}
{% set ext = namespace(up=0, down=0) %}
{% for key in ns.panels %}
  {% set pr = namespace(rows=[], peak=0) %}
  {% for r in rows if not p.panel or (r[p.panel] | string) == key %}
    {% set pr.rows = pr.rows + [r] %}
    {% for s in series_col %}{% set pr.peak = [pr.peak, r[s] | float] | max %}{% endfor %}
  {% endfor %}
  {% set ns.roots = ns.roots + [pr.peak ** 0.5] %}
  {% set step = 2 * math.pi / (pr.rows | length) %}
  {% for r in pr.rows %}
    {% set a0 = start + step * loop.index0 %}
    {% set t = namespace(v=0) %}
    {% for s in series_col %}{% set t.v = [t.v, r[s] | float] | max %}{% endfor %}
    {% set top = t.v ** 0.5 %}
    {% set lr = [top, label_floor * pr.peak ** 0.5] | max %}
    {% set am = a0 + step / 2 %}
    {% set a0m = a0 % (2 * math.pi) %}
    {% set has_top = a0m + step > 2 * math.pi %}
    {% set has_bottom = a0m <= math.pi < a0m + step %}
    {% set ext.up = [ext.up, top if has_top else top * [math.cos(a0), math.cos(a0 + step)] | max, lr * math.cos(am)] | max %}
    {% set ext.down = [ext.down, top if has_bottom else -top * [math.cos(a0), math.cos(a0 + step)] | min, -lr * math.cos(am)] | max %}
  {% endfor %}
{% endfor %}
{% set size = style.font.size %}
{% set small = style.charts.axis.labels.font.size %}
{% set legend_h = size * 2.4 %}
{% set caption_h = size * 2 if p.panel else 0 %}
{% set n_panels = ns.panels | length %}
{% set ph = height - legend_h - caption_h %}
{% set label_room = small * 3.2 %}
{% if ns.roots | max <= 0 %}{{ raise_error("A rose needs at least one positive value.") }}{% endif %}
{# Panels share one scale but not one width: each takes room in proportion to its own rose, so a small rose does not strand the big one. #}
{% set k = [(width - 2 * n_panels * label_room) / (2 * ns.roots | sum), (ph - 2 * label_room) / (ext.up + ext.down)] | min %}
{% set gap = (width - 2 * k * ns.roots | sum - 2 * n_panels * label_room) / n_panels %}
{% set cy = (ph - k * (ext.up + ext.down)) / 2 + k * ext.up %}
{# Radius is the square root of the value, so area (not radius) is proportional to it. #}
{% set radius = d3.scale_sqrt([0, (ns.roots | max) ** 2], [0, k * ns.roots | max]) %}
{% set left = namespace(x=0) %}
<g font-family="{{ style.font.family }}">
{% for key in ns.panels %}
  {% set r_max = k * ns.roots[loop.index0] %}
  {% set slot = 2 * (r_max + label_room) + gap %}
  {% set cx = left.x + slot / 2 %}
  {% set left.x = left.x + slot %}
  {% set pr = namespace(rows=[]) %}
  {% for r in rows if not p.panel or (r[p.panel] | string) == key %}{% set pr.rows = pr.rows + [r] %}{% endfor %}
  {% set step = 2 * math.pi / (pr.rows | length) %}
  {% for r in pr.rows %}
    {% set a0 = start + step * loop.index0 %}
    {% set a1 = a0 + step %}
    {% set wd = namespace(list=[]) %}
    {% for s in series_col %}{% set wd.list = wd.list + [{"name": s, "v": r[s] | float}] %}{% endfor %}
    {% set wedges = wd.list %}
    <g>
      <title>{{ r[label_col] }}{% for w in wedges %}; {{ w.name }} {{ w.v | format(p.value_format) }}{% endfor %}</title>
    {% for w in wedges | sort(attribute="v", reverse=true) %}
      {% set rr = radius(w.v) %}
      {% if rr > 0.3 %}
      <path transform="translate({{ cx|round(2) }},{{ cy|round(2) }})" d="{{ d3.arc(0, rr, a0, a1) }}" fill="{{ color_for(w.name, 'series') }}" stroke="{{ style.background }}" stroke-width="0.6"/>
      {% endif %}
    {% endfor %}
    </g>
    {% set am = (a0 + a1) / 2 %}
    {% set top = radius(wedges | map(attribute="v") | max) %}
    {% set lr = [top, r_max * label_floor] | max + small * 1.1 %}
    <text x="{{ (cx + lr * math.sin(am))|round(1) }}" y="{{ (cy - lr * math.cos(am))|round(1) }}" dy="0.35em" text-anchor="middle" font-size="{{ small }}" fill="{{ style.muted }}">{{ r[label_col] }}</text>
  {% endfor %}
  {% if p.panel %}
  <text x="{{ cx|round(1) }}" y="{{ (ph + size)|round(1) }}" text-anchor="middle" font-size="{{ size }}" fill="{{ style.font.color }}">{{ key }}</text>
  {% endif %}
{% endfor %}
{% set lx = namespace(x=0) %}
{% for s in series_col %}
  <rect x="{{ lx.x }}" y="{{ (height - size - 2)|round(1) }}" width="10" height="10" rx="2" fill="{{ color_for(s, 'series') }}"/>
  <text x="{{ lx.x + 14 }}" y="{{ (height - 3)|round(1) }}" font-size="{{ size }}" fill="{{ style.font.color }}">{{ s | replace("_", " ") }}</text>
  {% set lx.x = lx.x + 14 + text_width(s | replace("_", " "), size) + 22 %}
{% endfor %}
</g>
