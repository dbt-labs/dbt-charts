{#---
description: Flow diagram from an edge list, one row per flow, laid out by d3-sankey. Nodes sit in columns by their longest path from a start node; nodes with no outgoing flow end in the last column.
channels:
  x:
    description: Two columns, the node each flow leaves and then the node it enters.
    multiple: true
  value:
    description: Column holding the size of each flow.
options:
  value_format:
    type: string
    default: ',.0f'
    description: d3-format spec for node values in labels.
  node_width:
    type: number
    default: 10
  node_gap:
    type: number
    default: 12
---#}
{% set p = options %}
{% if channels.x | length != 2 %}{{ raise_error("x takes two columns: the source node, then the target node") }}{% endif %}
{% set source_col = channels.x[0] %}
{% set target_col = channels.x[1] %}
{% set value_col = channels.value %}
{% set label_size = style.font.size %}
{% set ns = namespace(links=[]) %}
{% for r in rows %}
  {% set v = r[value_col] | float %}
  {% if v <= 0 %}{{ raise_error("Flow values must be positive: " ~ r[source_col] ~ " -> " ~ r[target_col] ~ " is " ~ v) }}{% endif %}
  {% set ns.links = ns.links + [{"source": r[source_col] | string, "target": r[target_col] | string, "value": v}] %}
{% endfor %}
{% set g = d3.sankey(ns.links, size=[width, height], node_width=p.node_width, node_padding=p.node_gap) %}
{% set last = g.nodes | map(attribute="layer") | max %}
<g fill="none" stroke-opacity="0.35">
{% for l in g.links %}
  <path d="{{ d3.sankey_link_horizontal(l) }}" stroke="{{ color_for(l.source.name, source_col) }}" stroke-width="{{ [l.width, 1] | max | round(1) }}"><title>{{ l.source.name }} → {{ l.target.name }}: {{ l.value | format(p.value_format) }}</title></path>
{% endfor %}
</g>
<g font-family="{{ style.font.family }}" font-size="{{ label_size }}" fill="{{ style.font.color }}">
{% for n in g.nodes %}
  {% set hgt = [n.y1 - n.y0, 1] | max %}
  <rect x="{{ n.x0 | round(1) }}" y="{{ n.y0 | round(1) }}" width="{{ (n.x1 - n.x0) | round(1) }}" height="{{ hgt | round(1) }}" fill="{{ color_for(n.name, source_col) }}"><title>{{ n.name }}: {{ n.value | format(p.value_format) }}</title></rect>
  {% set end = n.layer == last %}
  {% set v = n.value | format(p.value_format) %}
  {% set nw = text_width(n.name, label_size, 600) %}
  {% set lx = n.x0 - 6 - nw - 4 - text_width(v, label_size) if end else n.x1 + 6 %}
  {% set ly = ((n.y0 + n.y1) / 2) | round(1) %}
  <text x="{{ lx | round(1) }}" y="{{ ly }}" dy="0.35em" font-weight="600">{{ n.name }}</text>
  <text x="{{ (lx + nw + 4) | round(1) }}" y="{{ ly }}" dy="0.35em" fill="{{ style.fonts.secondary.color }}">{{ v }}</text>
{% endfor %}
</g>
