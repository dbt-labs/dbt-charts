<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
      {%- if result.board_error -%}
        [{{ result.board_error.code }}] {{ result.board_error.message | truncate(60) }}
      {%- else -%}
        {{ result.validation_errors | length }} error{{ 's' if result.validation_errors | length != 1 else '' }} — {{ request_path }}
      {%- endif -%}
    </title>
    <style>
      :root {
        --page-bg: {{ palette.page_bg }};
        --font-family: {{ palette.font_family | safe }};
        --card-bg: {{ palette.card_bg }};
        --card-text: {{ palette.card_text }};
        --card-muted: color-mix(in srgb, var(--card-text) 60%, transparent);
        --card-rule: color-mix(in srgb, var(--card-text) 20%, transparent);
        --card-radius: {{ palette.card_radius }};
        --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      }
      body {
        margin: 0;
        padding: 40px 20px;
        background: var(--page-bg);
        font-family: var(--font-family);
      }
      .errors {
        max-width: 560px;
        margin: 32px auto 0;
      }
      .error {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin: 0 0 12px;
        padding: 16px 18px;
        background: var(--card-bg);
        color: var(--card-text);
        border-radius: var(--card-radius);
        box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
      }
      h1 {
        margin: 0;
        font-size: 1rem;
        font-weight: 600;
        line-height: 1.3;
      }
      p {
        margin: 0;
        font-size: 0.875rem;
        line-height: 1.45;
        overflow-wrap: anywhere;
      }
      .location,
      .code {
        font: 0.75rem/1.4 var(--mono);
        color: var(--card-muted);
      }
      .code {
        margin-top: 4px;
      }
      summary {
        cursor: pointer;
        font-size: 0.8125rem;
        font-weight: 600;
      }
      pre {
        margin: 8px 0 0;
        padding: 10px 12px;
        max-height: 420px;
        overflow: auto;
        border: 1px solid var(--card-rule);
        border-radius: var(--card-radius);
        font: 0.75rem/1.5 var(--mono);
        white-space: pre;
      }
      a {
        color: inherit;
      }
      .guide {
        margin: 0;
        font-size: 0.8125rem;
      }
      .guide a {
        color: var(--card-bg);
      }
    </style>
  </head>
  <body>
{% if chrome %}{{ chrome | safe }}
{% endif -%}
{%- macro error_card(err) %}
      <section class="error">
        <h1>{{ code_title(err.code) }}</h1>
        <p>{{ err.message }}</p>
        {%- if err.hint %}
        <p>{{ err.hint }}</p>
        {%- endif %}
        {%- if err.range %}
        <div class="location">{{ err.range.file }}:{{ err.range.start_line }}</div>
        {%- endif %}
        {%- if err.code == internal_code and err.detail %}
        <details>
          <summary>Details</summary>
          <pre>{{ err.detail }}</pre>
        </details>
        <p>This is a bug in dbt Charts. <a href="{{ issues_url }}/new" target="_blank" rel="noopener">Report it ↗</a></p>
        {%- elif caller is defined %}
        {{ caller() }}
        {%- endif %}
        <div class="code">{{ err.code }}</div>
      </section>
{%- endmacro %}
    <main class="errors">
{%- if result.board_error %}
      {%- call error_card(result.board_error) %}
        <p><a href="{{ doc_url(result.board_error.code) }}" target="_blank" rel="noopener">Open docs ↗</a></p>
      {%- endcall %}
{%- else %}
      {%- for err in result.validation_errors %}
      {{- error_card(err) }}
      {%- endfor %}
      <p class="guide"><a href="{{ error_guide_url }}" target="_blank" rel="noopener">How to read these errors ↗</a></p>
{%- endif %}
    </main>
  </body>
</html>
