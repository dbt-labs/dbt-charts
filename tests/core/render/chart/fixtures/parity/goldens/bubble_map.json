{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.4.1.json",
  "autosize": {
    "contains": "padding",
    "resize": true,
    "type": "fit"
  },
  "background": null,
  "config": {
    "circle": {
      "opacity": 1.0
    },
    "font": "'Inter Variable', 'Noto Emoji', Inter, system-ui, sans-serif",
    "range": {
      "category": [
        "#40639c",
        "#779bc9",
        "#608470",
        "#775770",
        "#d49656",
        "#ae6349",
        "#a0b6b7",
        "#ad9c7f",
        "#7a8895",
        "#5c6668"
      ]
    },
    "rule": {
      "stroke": "#222222",
      "strokeWidth": 1.0
    },
    "text": {
      "align": "center",
      "fill": "#313233",
      "font": "'Inter Variable', 'Noto Emoji', Inter, system-ui, sans-serif",
      "fontSize": 11.0,
      "fontWeight": "400"
    },
    "title": {
      "anchor": "start",
      "color": "#222222",
      "font": "'Source Serif 4', 'Noto Emoji', Georgia, 'Times New Roman', serif",
      "fontSize": 18,
      "fontWeight": 500,
      "offset": 10.0,
      "subtitleColor": "#8A8C8F",
      "subtitleFont": "'Inter Variable', 'Noto Emoji', Inter, system-ui, sans-serif",
      "subtitleFontSize": 11.0,
      "subtitleFontWeight": 400.0
    },
    "view": {
      "continuousHeight": 300.0,
      "continuousWidth": 360.0,
      "discreteHeight": 360.0,
      "discreteWidth": 360.0,
      "stroke": null
    }
  },
  "data": {
    "values": [
      {
        "count": 100,
        "lat": 40.7,
        "lon": -74.0,
        "name": "NYC",
        "pop": 8000000
      },
      {
        "count": 75,
        "lat": 34.0,
        "lon": -118.2,
        "name": "LA",
        "pop": 4000000
      },
      {
        "count": 50,
        "lat": 41.8,
        "lon": -87.6,
        "name": "CHI",
        "pop": 2700000
      }
    ]
  },
  "encoding": {
    "color": {
      "field": "count",
      "title": "Count",
      "type": "quantitative"
    },
    "latitude": {
      "field": "lat",
      "type": "quantitative"
    },
    "longitude": {
      "field": "lon",
      "type": "quantitative"
    },
    "size": {
      "field": "pop",
      "scale": {
        "domainMin": 0,
        "range": [
          0,
          1000.0
        ],
        "zero": true
      },
      "title": "Pop",
      "type": "quantitative"
    },
    "tooltip": [
      {
        "field": "lat",
        "title": "Latitude",
        "type": "quantitative"
      },
      {
        "field": "lon",
        "title": "Longitude",
        "type": "quantitative"
      },
      {
        "field": "pop",
        "format": ",.2~f",
        "title": "pop",
        "type": "quantitative"
      },
      {
        "field": "count",
        "title": "count",
        "type": "quantitative"
      },
      {
        "field": "name",
        "title": "name",
        "type": "nominal"
      }
    ]
  },
  "mark": {
    "clip": true,
    "opacity": 1.0,
    "tooltip": true,
    "type": "circle"
  },
  "padding": {
    "bottom": 0,
    "left": 0,
    "right": 0,
    "top": 0
  },
  "projection": {
    "type": "albersUsa"
  }
