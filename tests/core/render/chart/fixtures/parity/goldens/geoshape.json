{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.4.1.json",
  "autosize": {
    "contains": "padding",
    "resize": true,
    "type": "fit"
  },
  "background": null,
  "config": {
    "circle": {
      "opacity": 1.0
    },
    "font": "'Inter Variable', 'Noto Emoji', Inter, system-ui, sans-serif",
    "range": {
      "category": [
        "#40639c",
        "#779bc9",
        "#608470",
        "#775770",
        "#d49656",
        "#ae6349",
        "#a0b6b7",
        "#ad9c7f",
        "#7a8895",
        "#5c6668"
      ]
    },
    "rule": {
      "stroke": "#222222",
      "strokeWidth": 1.0
    },
    "text": {
      "align": "center",
      "fill": "#313233",
      "font": "'Inter Variable', 'Noto Emoji', Inter, system-ui, sans-serif",
      "fontSize": 11.0,
      "fontWeight": "400"
    },
    "title": {
      "anchor": "start",
      "color": "#222222",
      "font": "'Source Serif 4', 'Noto Emoji', Georgia, 'Times New Roman', serif",
      "fontSize": 18,
      "fontWeight": 500,
      "offset": 10.0,
      "subtitleColor": "#8A8C8F",
      "subtitleFont": "'Inter Variable', 'Noto Emoji', Inter, system-ui, sans-serif",
      "subtitleFontSize": 11.0,
      "subtitleFontWeight": 400.0
    },
    "view": {
      "continuousHeight": 300.0,
      "continuousWidth": 360.0,
      "discreteHeight": 360.0,
      "discreteWidth": 360.0,
      "stroke": null
    }
  },
  "layer": [
    {
      "data": {
        "format": {
          "feature": "states",
          "type": "topojson"
        },
        "url": "https://vega.github.io/vega-datasets/data/us-10m.json"
      },
      "mark": {
        "fill": "#D0D3D9",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.5,
        "type": "geoshape"
      }
    },
    {
      "data": {
        "format": {
          "feature": "states",
          "type": "topojson"
        },
        "url": "https://vega.github.io/vega-datasets/data/us-10m.json"
      },
      "encoding": {
        "color": {
          "field": "population",
          "legend": {
            "direction": "vertical",
            "labelColor": "#626366",
            "labelFont": "'Inter Variable', 'Noto Emoji', Inter, system-ui, sans-serif",
            "labelFontSize": 11.0,
            "labelFontWeight": "400",
            "labelLimit": 200.0,
            "labelOffset": 8.0,
            "orient": "right",
            "symbolLimit": 20,
            "titleColor": "#313233",
            "titleFont": "'Inter Variable', 'Noto Emoji', Inter, system-ui, sans-serif",
            "titleFontSize": 12.0,
            "titleFontWeight": 600.0
          },
          "scale": {
            "range": [
              "#e4f0fc",
              "#c1dbf5",
              "#9fc5eb",
              "#80b0de",
              "#649acf",
              "#4a85bc",
              "#3270a8",
              "#1b5b92",
              "#04477a",
              "#00345d",
              "#002341"
            ]
          },
          "title": "Population",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "state_id",
            "title": "state ID",
            "type": "nominal"
          },
          {
            "field": "population",
            "format": ",.2~f",
            "title": "population",
            "type": "quantitative"
          }
        ]
      },
      "mark": {
        "stroke": "#FFFFFF",
        "strokeWidth": 0.5,
        "tooltip": true,
        "type": "geoshape"
      },
      "transform": [
        {
          "from": {
            "data": {
              "values": [
                {
                  "population": 39538223,
                  "state_id": 6
                },
                {
                  "population": 29145505,
                  "state_id": 48
                },
                {
                  "population": 20201249,
                  "state_id": 36
                }
              ]
            },
            "fields": [
              "state_id",
              "population"
            ],
            "key": "state_id"
          },
          "lookup": "id"
        }
      ]
    }
  ],
  "padding": {
    "bottom": 0,
    "left": 0,
    "right": 0,
    "top": 0
  },
  "projection": {
    "type": "albersUsa"
  }
}
