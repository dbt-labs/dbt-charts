{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.4.1.json",
  "autosize": {
    "contains": "padding",
    "resize": true,
    "type": "fit"
  },
  "background": "#FFFFFF",
  "config": {
    "circle": {
      "opacity": 1.0
    },
    "font": "'Inter Variable', 'Noto Emoji', Inter, system-ui, sans-serif",
    "range": {
      "category": [
        "#40639c",
        "#779bc9",
        "#608470",
        "#775770",
        "#d49656",
        "#ae6349",
        "#a0b6b7",
        "#ad9c7f",
        "#7a8895",
        "#5c6668"
      ]
    },
    "rule": {
      "stroke": "#222222",
      "strokeWidth": 1.0
    },
    "text": {
      "align": "center",
      "fill": "#313233",
      "font": "'Inter Variable', 'Noto Emoji', Inter, system-ui, sans-serif",
      "fontSize": 11.0,
      "fontWeight": "400"
    },
    "title": {
      "anchor": "start",
      "color": "#494A4C",
      "font": "'Source Serif 4', 'Noto Emoji', Georgia, 'Times New Roman', serif",
      "fontSize": 18,
      "fontWeight": 500,
      "offset": 10.0,
      "subtitleColor": "#8A8C8F",
      "subtitleFont": "'Inter Variable', 'Noto Emoji', Inter, system-ui, sans-serif",
      "subtitleFontSize": 11.0,
      "subtitleFontWeight": 400.0
    },
    "view": {
      "continuousHeight": 300.0,
      "continuousWidth": 360.0,
      "discreteHeight": 360.0,
      "discreteWidth": 360.0,
      "stroke": null
    }
  },
  "data": {
    "values": [
      {
        "category": "A",
        "month": "Jan",
        "value": 10
      },
      {
        "category": "A",
        "month": "Feb",
        "value": 20
      },
      {
        "category": "B",
        "month": "Jan",
        "value": 30
      },
      {
        "category": "B",
        "month": "Feb",
        "value": 40
      }
    ]
  },
  "encoding": {
    "color": {
      "field": "value",
      "format": ",.2~f",
      "legend": {
        "direction": "vertical",
        "labelColor": "#626366",
        "labelFont": "'Inter Variable', 'Noto Emoji', Inter, system-ui, sans-serif",
        "labelFontSize": 11.0,
        "labelFontWeight": "400",
        "labelLimit": 200.0,
        "labelOffset": 8.0,
        "orient": "right",
        "symbolLimit": 20,
        "titleColor": "#313233",
        "titleFont": "'Inter Variable', 'Noto Emoji', Inter, system-ui, sans-serif",
        "titleFontSize": 12.0,
        "titleFontWeight": 600.0,
        "values": [
          10.0,
          20.0,
          30.0,
          40.0
        ]
      },
      "scale": {
        "domain": [
          10.0,
          40.0
        ],
        "range": [
          "#e4f0fc",
          "#c1dbf5",
          "#9fc5eb",
          "#80b0de",
          "#649acf",
          "#4a85bc",
          "#3270a8",
          "#1b5b92",
          "#04477a",
          "#00345d",
          "#002341"
        ]
      },
      "title": "Value",
      "type": "quantitative"
    },
    "description": {
      "value": {
        "expr": "\"\\u2061\" + (datum[\"month\"]) + '; ' + \"\\u2061\" + (datum[\"category\"]) + '; ' + \"Value: \" + (format(datum[\"value\"], \",.2~f\"))"
      }
    },
    "x": {
      "axis": {
        "domain": false,
        "domainColor": "#EDEFF2",
        "domainWidth": 1.0,
        "grid": false,
        "gridColor": "#EDEFF2",
        "gridOpacity": 1.0,
        "gridWidth": 1.0,
        "labelAngle": 0.0,
        "labelColor": "#626366",
        "labelFont": "'Inter Variable', 'Noto Emoji', Inter, system-ui, sans-serif",
        "labelFontSize": 11.0,
        "labelFontWeight": "400",
        "labelOverlap": false,
        "labelPadding": 6.0,
        "labelSeparation": 16.0,
        "offset": 1.0,
        "tickColor": "#EDEFF2",
        "tickSize": 6.0,
        "tickWidth": 1.0,
        "ticks": true,
        "title": null
      },
      "field": "month",
      "sort": null,
      "title": "month",
      "type": "nominal"
    },
    "y": {
      "axis": {
        "domain": false,
        "domainColor": "#EDEFF2",
        "domainWidth": 1.0,
        "grid": false,
        "gridColor": "#D0D3D9",
        "gridOpacity": 1.0,
        "gridWidth": 1.5,
        "labelAlign": "left",
        "labelColor": "#626366",
        "labelFont": "'Inter Variable', 'Noto Emoji', Inter, system-ui, sans-serif",
        "labelFontSize": 11.0,
        "labelFontWeight": "400",
        "labelPadding": 11.58935546875,
        "labelSeparation": 16.0,
        "orient": "left",
        "tickColor": "#D0D3D9",
        "tickSize": 6.0,
        "tickWidth": 1.5,
        "ticks": false,
        "title": null
      },
      "field": "category",
      "sort": null,
      "title": "category",
      "type": "nominal"
    }
  },
  "mark": {
    "tooltip": true,
    "type": "rect"
  },
  "padding": {
    "bottom": 0,
    "left": 0,
    "right": 0,
    "top": 0
  }
}
