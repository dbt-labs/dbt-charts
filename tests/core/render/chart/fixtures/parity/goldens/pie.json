{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.4.1.json",
  "autosize": {
    "contains": "padding",
    "resize": true,
    "type": "fit"
  },
  "background": "#FFFFFF",
  "config": {
    "circle": {
      "opacity": 1.0
    },
    "font": "'Inter Variable', 'Noto Emoji', Inter, system-ui, sans-serif",
    "range": {
      "category": [
        "#40639c",
        "#779bc9",
        "#608470",
        "#775770",
        "#d49656",
        "#ae6349",
        "#a0b6b7",
        "#ad9c7f",
        "#7a8895",
        "#5c6668"
      ]
    },
    "rule": {
      "stroke": "#222222",
      "strokeWidth": 1.0
    },
    "text": {
      "align": "center",
      "fill": "#313233",
      "font": "'Inter Variable', 'Noto Emoji', Inter, system-ui, sans-serif",
      "fontSize": 11.0,
      "fontWeight": "400"
    },
    "title": {
      "anchor": "start",
      "color": "#494A4C",
      "font": "'Source Serif 4', 'Noto Emoji', Georgia, 'Times New Roman', serif",
      "fontSize": 18,
      "fontWeight": 500,
      "offset": 10.0,
      "subtitleColor": "#8A8C8F",
      "subtitleFont": "'Inter Variable', 'Noto Emoji', Inter, system-ui, sans-serif",
      "subtitleFontSize": 11.0,
      "subtitleFontWeight": 400.0
    },
    "view": {
      "continuousHeight": 300.0,
      "continuousWidth": 360.0,
      "discreteHeight": 360.0,
      "discreteWidth": 360.0,
      "stroke": null
    }
  },
  "data": {
    "values": [
      {
        "__dbt_label": [
          "50% Widgets",
          "300"
        ],
        "__dbt_label_lines": 2,
        "__dbt_mid": 1.5707963267948966,
        "__dbt_pct": 0.5,
        "__dbt_right": true,
        "__dbt_row_idx": 0,
        "__dbt_top": true,
        "__dbt_total": 600.0,
        "revenue": 300,
        "segment": "Widgets"
      },
      {
        "__dbt_label": [
          "33% Gizmos",
          "200"
        ],
        "__dbt_label_lines": 2,
        "__dbt_mid": 4.188790204786391,
        "__dbt_pct": 0.3333333333333333,
        "__dbt_right": false,
        "__dbt_row_idx": 1,
        "__dbt_top": false,
        "__dbt_total": 600.0,
        "revenue": 200,
        "segment": "Gizmos"
      },
      {
        "__dbt_label": [
          "17% Thingies",
          "100"
        ],
        "__dbt_label_lines": 2,
        "__dbt_mid": 5.759586531581288,
        "__dbt_pct": 0.16666666666666666,
        "__dbt_right": false,
        "__dbt_row_idx": 2,
        "__dbt_top": true,
        "__dbt_total": 600.0,
        "revenue": 100,
        "segment": "Thingies"
      }
    ]
  },
  "encoding": {
    "description": {
      "value": {
        "expr": "\"\\u2064\" + (datum[\"segment\"]) + '; ' + \"Share: \" + (format(datum[\"__dbt_pct\"], \".0%\")) + '; ' + \"\\u2060Revenue: \" + (format(datum[\"revenue\"], \",.2~f\")) + '; ' + \"\\u2060\\u2063Total: \" + (format(datum[\"__dbt_total\"], \",.2~f\"))"
      }
    }
  },
  "layer": [
    {
      "encoding": {
        "color": {
          "field": "segment",
          "legend": null,
          "sort": false,
          "title": "Segment",
          "type": "nominal"
        },
        "order": {
          "field": "__dbt_row_idx",
          "type": "quantitative"
        },
        "theta": {
          "field": "revenue",
          "format": ",.2~f",
          "title": "Revenue",
          "type": "quantitative"
        }
      },
      "mark": {
        "cornerRadius": 3.0,
        "innerRadius": 0,
        "outerRadius": {
          "expr": "min(width, height) / 2 * 0.9"
        },
        "padAngle": 0.0,
        "stroke": "#FFFFFF",
        "strokeJoin": "round",
        "strokeWidth": 3.0,
        "tooltip": true,
        "type": "arc"
      }
    },
    {
      "encoding": {
        "color": {
          "field": "segment",
          "legend": null,
          "scale": {
            "domain": [
              "Widgets",
              "Gizmos",
              "Thingies"
            ],
            "range": [
              "#284980",
              "#4d709b",
              "#406350"
            ]
          },
          "sort": false,
          "type": "nominal"
        },
        "text": {
          "field": "__dbt_label",
          "type": "nominal"
        },
        "x": {
          "axis": null,
          "field": "__dbt_x",
          "scale": null,
          "type": "quantitative"
        },
        "y": {
          "axis": null,
          "field": "__dbt_y_anchored",
          "scale": null,
          "type": "quantitative"
        }
      },
      "mark": {
        "align": {
          "expr": "datum.__dbt_right ? 'left' : 'right'"
        },
        "baseline": "top",
        "font": "'Inter Variable', 'Noto Emoji', Inter, system-ui, sans-serif",
        "fontSize": 14.0,
        "fontStyle": "normal",
        "fontWeight": "500",
        "lineHeight": 14.0,
        "tooltip": false,
        "type": "text"
      },
      "transform": [
        {
          "filter": "datum.__dbt_label != null"
        },
        {
          "as": "__dbt_x",
          "calculate": "width / 2 + sin(datum.__dbt_mid) * (min(width, height) / 2 * 0.9 + 6.0)"
        },
        {
          "as": "__dbt_y",
          "calculate": "height / 2 - cos(datum.__dbt_mid) * (min(width, height) / 2 * 0.9 + 6.0)"
        },
        {
          "as": "__dbt_y_anchored",
          "calculate": "datum.__dbt_y + (datum.__dbt_top ? -(datum.__dbt_label_lines * 14.0) : 0)"
        }
      ]
    }
  ],
  "padding": {
    "bottom": 0,
    "left": 0,
    "right": 0,
    "top": 0
  },
  "resolve": {
    "scale": {
      "color": "independent"
    }
  }
}
