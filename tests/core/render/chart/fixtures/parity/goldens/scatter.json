{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.4.1.json",
  "autosize": {
    "contains": "padding",
    "resize": true,
    "type": "fit"
  },
  "background": "#FFFFFF",
  "config": {
    "circle": {
      "opacity": 1.0
    },
    "font": "'Inter Variable', 'Noto Emoji', Inter, system-ui, sans-serif",
    "range": {
      "category": [
        "#40639c",
        "#779bc9",
        "#608470",
        "#775770",
        "#d49656",
        "#ae6349",
        "#a0b6b7",
        "#ad9c7f",
        "#7a8895",
        "#5c6668"
      ]
    },
    "rule": {
      "stroke": "#222222",
      "strokeWidth": 1.0
    },
    "text": {
      "align": "center",
      "fill": "#313233",
      "font": "'Inter Variable', 'Noto Emoji', Inter, system-ui, sans-serif",
      "fontSize": 11.0,
      "fontWeight": "400"
    },
    "title": {
      "anchor": "start",
      "color": "#222222",
      "font": "'Source Serif 4', 'Noto Emoji', Georgia, 'Times New Roman', serif",
      "fontSize": 18,
      "fontWeight": 500,
      "offset": 10.0,
      "subtitleColor": "#8A8C8F",
      "subtitleFont": "'Inter Variable', 'Noto Emoji', Inter, system-ui, sans-serif",
      "subtitleFontSize": 11.0,
      "subtitleFontWeight": 400.0
    },
    "view": {
      "continuousHeight": 300.0,
      "continuousWidth": 360.0,
      "discreteHeight": 360.0,
      "discreteWidth": 360.0,
      "stroke": null
    }
  },
  "data": {
    "values": [
      {
        "cost": 100,
        "revenue": 200
      },
      {
        "cost": 150,
        "revenue": 350
      },
      {
        "cost": 80,
        "revenue": 180
      }
    ]
  },
  "encoding": {
    "description": {
      "value": {
        "expr": "\"revenue: \" + (format(datum[\"revenue\"], \",.2~f\")) + '; ' + \"cost: \" + (format(datum[\"cost\"], \",.2~f\"))"
      }
    },
    "x": {
      "axis": {
        "domain": false,
        "domainColor": "#EDEFF2",
        "domainWidth": 1.0,
        "format": ".3~s",
        "grid": true,
        "gridColor": "#D0D3D9",
        "gridOpacity": 1.0,
        "gridWidth": 1.5,
        "labelAngle": 0.0,
        "labelColor": "#222222",
        "labelExpr": "(abs(datum.value) < 1 ? (datum.value !== 0 && abs(datum.value) < 1e-10 ? format(datum.value,\".3~e\") : format(datum.value,\".3~r\")) : format(datum.value,\".3~s\"))",
        "labelFont": "'dbt Sans Tabular', 'Noto Emoji', Inter, system-ui, sans-serif",
        "labelFontSize": 11.0,
        "labelFontWeight": "400",
        "labelPadding": 6.0,
        "labelSeparation": 16.0,
        "offset": 1.0,
        "tickColor": "#D0D3D9",
        "tickCount": 6,
        "tickSize": 6.0,
        "tickWidth": 1.5,
        "ticks": false,
        "titleColor": "#8A8C8F",
        "titleFont": "'Inter Variable', 'Noto Emoji', Inter, system-ui, sans-serif",
        "titleFontSize": 11.0,
        "titleFontWeight": 600.0,
        "titlePadding": 10.0
      },
      "field": "cost",
      "scale": {
        "padding": 0.0
      },
      "title": "cost",
      "type": "quantitative"
    },
    "y": {
      "axis": {
        "domain": false,
        "domainColor": "#EDEFF2",
        "domainWidth": 1.0,
        "format": ".3~s",
        "grid": true,
        "gridColor": "#D0D3D9",
        "gridOpacity": 1.0,
        "gridWidth": 1.5,
        "labelAlign": "right",
        "labelColor": "#222222",
        "labelExpr": "format(datum.value,\",.0~f\")",
        "labelFont": "'dbt Sans Tabular', 'Noto Emoji', Inter, system-ui, sans-serif",
        "labelFontSize": 11.0,
        "labelFontWeight": "400",
        "labelPadding": 24.98486328125,
        "labelSeparation": 16.0,
        "orient": "right",
        "tickColor": "#D0D3D9",
        "tickSize": 6.0,
        "tickWidth": 1.5,
        "ticks": false,
        "titleColor": "#8A8C8F",
        "titleFont": "'Inter Variable', 'Noto Emoji', Inter, system-ui, sans-serif",
        "titleFontSize": 11.0,
        "titleFontWeight": 600.0,
        "titlePadding": 10.0,
        "values": [
          150.0,
          200.0,
          250.0,
          300.0,
          350.0,
          400.0
        ]
      },
      "field": "revenue",
      "format": ",.2~f",
      "scale": {
        "domainMax": 363.6,
        "domainMin": 166.4,
        "zero": false
      },
      "title": "revenue",
      "type": "quantitative"
    }
  },
  "mark": {
    "fill": "#284980",
    "filled": true,
    "opacity": 1.0,
    "size": 60.0,
    "strokeWidth": 2.5,
    "tooltip": true,
    "type": "point"
  },
  "padding": {
    "bottom": 0,
    "left": 0,
    "right": 0,
    "top": 0
  }
}
