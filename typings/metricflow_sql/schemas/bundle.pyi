from collections.abc import Iterable, Mapping

from sqlglot.dialects.dialect import NormalizationStrategy

class Bundle:
    files: Mapping[str, bytes]
    def __init__(self, files: Mapping[str, bytes]) -> None: ...

def bundle_name(bundle: Bundle) -> str: ...
def bundle_dialect(bundle: Bundle) -> str: ...
def bundle_normalization_strategy(bundle: Bundle) -> NormalizationStrategy: ...
def load_bundle(
    bundle: Bundle, normalization_strategy: NormalizationStrategy | None = ...
) -> Iterable[object]: ...
