# The slice of nanoarrow's API dbt-charts uses; nanoarrow ships no type information.
import enum
from collections.abc import Iterable, Iterator
from typing import Any

from nanoarrow._array import CArray
from nanoarrow._array_stream import CArrayStream
from nanoarrow._schema import CSchema

class Type(enum.Enum):
    NULL = ...
    BOOL = ...
    INT8 = ...
    INT16 = ...
    INT32 = ...
    INT64 = ...
    DOUBLE = ...
    STRING = ...
    BINARY = ...
    DATE32 = ...
    TIMESTAMP = ...
    TIME64 = ...
    DECIMAL128 = ...
    DECIMAL256 = ...
    DURATION = ...

class Schema:
    def __init__(self, obj: object, *, name: str | None = None) -> None: ...
    @property
    def type(self) -> Type: ...
    @property
    def name(self) -> str | None: ...
    @property
    def n_fields(self) -> int: ...
    def field(self, i: int) -> Schema: ...
    @property
    def precision(self) -> int: ...
    @property
    def scale(self) -> int: ...
    def __arrow_c_schema__(self) -> Any: ...

class Array:
    def __init__(self, obj: object) -> None: ...
    @staticmethod
    def from_chunks(obj: Iterable[object], schema: object | None = None) -> Array: ...
    @property
    def schema(self) -> Schema: ...
    def child(self, i: int) -> Array: ...
    def iter_chunks(self) -> Iterator[Array]: ...
    def to_pylist(self) -> list[Any]: ...
    def __len__(self) -> int: ...
    def __arrow_c_stream__(self, requested_schema: object | None = None) -> Any: ...

def c_schema(obj: object) -> CSchema: ...
def c_array(obj: object, schema: object | None = None) -> CArray: ...
def c_array_from_buffers(
    schema: object,
    length: int,
    buffers: Iterable[object],
    null_count: int = -1,
    offset: int = 0,
    children: Iterable[object] = (),
) -> CArray: ...
def c_array_stream(obj: object) -> CArrayStream: ...
def struct(fields: Iterable[Schema] | dict[str, object]) -> Schema: ...
def null() -> Schema: ...
def bool_() -> Schema: ...
def int8() -> Schema: ...
def int16() -> Schema: ...
def int32() -> Schema: ...
def int64() -> Schema: ...
def float64() -> Schema: ...
def string() -> Schema: ...
def binary() -> Schema: ...
def fixed_size_binary(byte_width: int) -> Schema: ...
def date32() -> Schema: ...
def time64(unit: str) -> Schema: ...
def timestamp(unit: str, timezone: str | None = None) -> Schema: ...
def duration(unit: str) -> Schema: ...
def decimal128(precision: int, scale: int) -> Schema: ...
